<Project>
  <!--
    Shared project metadata for all projects in the solution.
  -->
  <PropertyGroup>
    <Authors>Bruno Capuano and OpenClawNet Contributors</Authors>
    <Company>OpenClawNet</Company>
    <Product>OpenClawNet</Product>
    <Copyright>Copyright © 2025 OpenClawNet Contributors</Copyright>
    <PackageProjectUrl>https://github.com/elbruno/openclawnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elbruno/openclawnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
