<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress experimental-API warnings raised by ModelContextProtocol 1.2.0 abstract bases -->
    <NoWarn>$(NoWarn);MCPEXP002;MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClawNet.Mcp.Abstractions\OpenClawNet.Mcp.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP C# SDK — pinned to 2.1.0 and validated in issue #232.
         Re-run MCP unit/integration coverage before future major-version bumps. -->
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenClawNet.UnitTests" />
  </ItemGroup>

</Project>
